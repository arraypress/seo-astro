---
/**
 * SEO.astro
 * ---------
 *
 * One page's head tags: title, description, canonical, Open Graph and Twitter,
 * robots, hreflang, article meta, verification and JSON-LD. Needs the `seo()`
 * integration in `astro.config`, which supplies the site-wide defaults, the
 * site-wide JSON-LD and the generated OG card.
 *
 * @example
 *   ---
 *   import { SEO } from '@arraypress/seo-astro';
 *   ---
 *   <head>
 *     <meta charset="utf-8" />
 *     <SEO title="My Page" description="A great page" />
 *   </head>
 *
 *   The canonical is derived from the current URL (tracking params stripped);
 *   pass `url` only to override it. With no `image`, the page gets a card
 *   rendered at build; `og={{ eyebrow: 'Blog' }}` changes it, `og={false}`
 *   turns it off.
 */
import config from 'virtual:@arraypress/seo-astro/config';
import { pageHead } from './head/page.js';
import type { SEOProps } from './types';

const head = pageHead(Astro.props as SEOProps, { config, url: Astro.url, site: Astro.site });
---
<Fragment set:html={head} />
