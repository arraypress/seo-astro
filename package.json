{
  "name": "@arraypress/seo-astro",
  "version": "2.2.1",
  "description": "SEO for Astro — an idiomatic <SEO> component, a Breadcrumbs component, a build-time SEO audit integration, and the head/robots.txt builders behind them. Title, canonical, Open Graph, Twitter, robots, hreflang and JSON-LD. Zero dependencies.",
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./SEO.astro": "./src/SEO.astro",
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./src/core.d.ts",
      "default": "./src/core.js"
    },
    "./Breadcrumbs.astro": "./src/Breadcrumbs.astro",
    "./audit": {
      "types": "./src/integration.ts",
      "default": "./src/integration.ts"
    },
    "./audit/core": {
      "types": "./src/audit.d.ts",
      "default": "./src/audit.js"
    }
  },
  "keywords": [
    "astro",
    "astro-component",
    "seo",
    "open-graph",
    "twitter-cards",
    "json-ld",
    "meta-tags",
    "withastro"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/seo-astro.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "astro": "^7.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
