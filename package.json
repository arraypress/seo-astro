{
  "name": "@arraypress/seo-astro",
  "version": "3.0.0",
  "description": "SEO for Astro in one integration: seo() feeds the <SEO> component, renders an Open Graph card for every page at build, writes llms.txt and a _headers file with a hash-based CSP, and audits the built site. Title, canonical, Open Graph, Twitter, robots, hreflang and connected JSON-LD.",
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./integration": {
      "types": "./src/integration/index.ts",
      "default": "./src/integration/index.ts"
    },
    "./SEO.astro": "./src/SEO.astro",
    "./Breadcrumbs.astro": "./src/Breadcrumbs.astro",
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "default": "./src/core.js"
    },
    "./jsonld": {
      "types": "./src/jsonld.d.ts",
      "default": "./src/jsonld.js"
    },
    "./llms": {
      "types": "./src/llms/index.ts",
      "default": "./src/llms/index.ts"
    },
    "./llms/core": {
      "types": "./src/llms/core.d.ts",
      "default": "./src/llms/core.js"
    },
    "./audit/core": {
      "types": "./src/audit/core.d.ts",
      "default": "./src/audit/core.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "seo",
    "open-graph",
    "og-image",
    "twitter-cards",
    "json-ld",
    "meta-tags",
    "llms-txt",
    "csp",
    "security-headers",
    "withastro"
  ],
  "author": "ArrayPress Limited",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/seo-astro.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@arraypress/jsonld": "^1.5.0",
    "@arraypress/security-headers": "file:../../Core/security-headers",
    "@arraypress/site-url": "^1.0.0"
  },
  "peerDependencies": {
    "@arraypress/og-image": "^1.3.0",
    "astro": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@arraypress/og-image": {
      "optional": true
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arraypress/og-image": "file:../../Core/og-image",
    "@types/node": "^26.4.1",
    "astro": "^7.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
